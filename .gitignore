node_modules/
dist/
coverage/

# NOTE: no blanket `build/` rule. It used to be here and it silently excluded
# packages/datasets/build — the versioned food and exercise index artefacts,
# which are deliberately committed. ADR-0007 serves them from the public repo
# via jsDelivr, which requires them to be in the repo, and apps/web copies them
# into public/data before dev and build, which fails on a fresh clone without
# them. Ignore build output per-package instead of by pattern.
.turbo/
*.log

# Secrets — never commit. See SECURITY.md
.env
.env.*
!.env.example
*-service-account*.json
*serviceAccount*.json
service-account*.json
gha-creds-*.json
.firebase-admin-key*

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# NOTE: .terraform.lock.hcl is deliberately NOT ignored. Terraform's dependency
# lock file belongs in version control — it pins provider versions and hashes so
# every contributor and CI run resolves identical providers (ADR-0012).

# Firebase emulator
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
emulator-data/

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Generated by apps/web/scripts/sync-datasets.mjs — source of truth is packages/datasets/build
apps/web/public/data/

# TypeScript incremental build state — machine-specific, never useful in git
*.tsbuildinfo

# Lighthouse CI run output
.lighthouseci/

# Storybook static build output
storybook-static/
