# Copy to .env.local for local development.
#
# You do NOT need any of these to develop against the Firebase emulator.
# `pnpm dev` runs entirely offline with seeded fixtures. See CONTRIBUTING.md.
#
# NOTE: the Firebase *client* config below is NOT secret. It is a public project
# identifier, documented as safe to expose. Real protection comes from Firestore
# Security Rules + App Check. See ADR-0010.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_APPCHECK_SITE_KEY=

VITE_USE_EMULATOR=true

# Server-side only. Never in a VITE_ variable, never in the client bundle,
# never in this repo. Lives in GCP Secret Manager in real environments.
# ANTHROPIC_API_KEY=
