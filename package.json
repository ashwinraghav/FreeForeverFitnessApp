{
  "name": "thefreeforeverfitnessapp",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @freeforever/web dev",
    "build": "pnpm -r build",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm --filter @freeforever/data test:sync",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm -r test",
    "test:rules": "pnpm --filter @freeforever/data test:rules",
    "emulators": "firebase emulators:start --import ./emulator-data --export-on-exit",
    "scan:secrets": "gitleaks detect --no-banner --redact -c .gitleaks.toml",
    "adr": "node scripts/new-adr.mjs",
    "storybook": "storybook dev -p 6007 --no-open",
    "build-storybook": "storybook build",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@freeforever/design-system": "workspace:*",
    "@storybook/addon-a11y": "8.6.14",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "eslint": "9.19.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "15.14.0",
    "storybook": "8.6.17",
    "typescript": "5.7.3",
    "typescript-eslint": "8.23.0"
  }
}
